# Aliyun ISI credentials. Do not commit real values.
# The application accepts the local names below, plus ALIYUN_NLS_APP_KEY and
# ALIYUN_NLS_TOKEN for compatibility with NLS examples.
ALIYUN_APP_ID=
ALIYUN_TMP_TOKEN=
# macOS AVFoundation microphone index. Run `ffmpeg -f avfoundation -list_devices true -i ''`
# to list devices. Default: 0.
LISTEN_INSTANT_ANS_AUDIO_DEVICE=0

# MiMo official API, OpenAI-compatible Chat Completions.
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.6-flash
# Per-turn agent timeout in milliseconds. Default: 30000.
AGENT_RUN_TIMEOUT_MS=30000
