# Optional. The keys can also be typed into the "设置" panel of the app, which stores them in
# ~/.listen-instant-ans/settings.json. A value saved there wins over these.

# MiMo (answers), OpenAI-compatible Chat Completions.
MIMO_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.6-flash

# Aliyun intelligent speech (speech to text). The token is temporary and expires.
ALIYUN_APP_ID=
ALIYUN_TMP_TOKEN=

# Where things are kept (defaults shown).
# LISTEN_INSTANT_ANS_SETTINGS=~/.listen-instant-ans/settings.json
# LISTEN_INSTANT_ANS_DATABASE=~/.listen-instant-ans/data.sqlite
# PORT=3100
